# Variables para docker-compose.yml (solo desarrollo).
# Copia este archivo a .env y rellena las contraseñas.
# Usuario, contraseña y base de datos deben coincidir con backend/.env.

# Puertos en el PC (solo accesibles desde 127.0.0.1)
DB_PORT=3307
ADMINER_PORT=8081

# Base de datos de desarrollo
DB_DATABASE=ovidex
DB_USERNAME=ovidex
DB_PASSWORD=
DB_ROOT_PASSWORD=
